# Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================
# Server Configuration
# ============================================
SERVERPOD_ENV=production
SERVER_PORT=8080
API_PORT=8081
INSIGHTS_PORT=8082

# ============================================
# Database Configuration
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=talktive_production
POSTGRES_USER=talktive_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ============================================
# Firebase Configuration
# ============================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# ============================================
# Security
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_JWT_SECRET
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# ============================================
# Monitoring (Optional)
# ============================================
SENTRY_DSN=
LOG_LEVEL=info

# ============================================
# Email (Optional - for notifications)
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@talktive.app

# ============================================
# Storage (Optional - for image uploads)
# ============================================
# Local storage (default)
STORAGE_TYPE=local
STORAGE_PATH=/app/uploads

# Or use Backblaze B2
# STORAGE_TYPE=b2
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET_NAME=
# B2_BUCKET_ID=

# Or use AWS S3
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FLOOR_0_PER_MINUTE=5
RATE_LIMIT_FLOOR_1_PER_MINUTE=10
RATE_LIMIT_FLOOR_2_PER_MINUTE=15

# ============================================
# Content Filtering
# ============================================
CONTENT_FILTER_ENABLED=true
PROFANITY_FILTER_STRICT=true

# ============================================
# Caching
# ============================================
CACHE_ENABLED=true
CACHE_STATS_TTL=300
CACHE_USER_TTL=600
CACHE_TRENDING_TTL=900
CACHE_POPULAR_TTL=1800

# ============================================
# Feature Flags
# ============================================
FEATURE_PUSH_NOTIFICATIONS=true
FEATURE_ACHIEVEMENTS=true
FEATURE_STREAKS=true
FEATURE_MOMENTS=true
FEATURE_GROUPS=true
FEATURE_PRIVATE_CHATS=true
FEATURE_ADMIN_DASHBOARD=true

# ============================================
# Limits
# ============================================
MAX_MESSAGE_LENGTH=1000
MAX_CAPTION_LENGTH=500
MAX_GROUP_MEMBERS=500
MAX_UPLOAD_SIZE_MB=5

# ============================================
# URLs
# ============================================
API_BASE_URL=https://api.talktive.app
WEB_BASE_URL=https://talktive.app
INSIGHTS_BASE_URL=https://insights.talktive.app
